@echo off
setlocal EnableExtensions EnableDelayedExpansion

rem ============================================================
rem  patch_sublime.bat  -  single-file patcher
rem  Target: Sublime Text Build 4215 ONLY
rem
rem  Usage: drag sublime_text.exe onto this .bat file.
rem         Multiple files supported (processed one by one).
rem
rem  Note: the PowerShell payload is embedded at the end of this
rem        file between [B64START] and [B64END] as Base64(UTF-16LE).
rem        It is read back and executed at runtime, so the command
rem        line stays short and files are passed via environment vars.
rem ============================================================

if "%~1"=="" (
    echo.
    echo  [INFO] Drag the Sublime Text Build 4215 sublime_text.exe onto this file.
    echo         Other versions will be refused with no changes made.
    echo.
    pause
    exit /b 2
)

set "PS_SELF=%~f0"
set "PS_TARGETS="
for %%F in (%*) do (
    if defined PS_TARGETS (
        set "PS_TARGETS=!PS_TARGETS!|%%~F"
    ) else (
        set "PS_TARGETS=%%~F"
    )
)

powershell -NoProfile -ExecutionPolicy Bypass -Command "$f=[Environment]::GetEnvironmentVariable('PS_SELF');$t=[IO.File]::ReadAllText($f);$A='[B64START]';$B='[B64END]';$i=$t.LastIndexOf($A);$j=$t.LastIndexOf($B);$s=$t.Substring($i+$A.Length,$j-$i-$A.Length);$s=$s.Replace([string][char]13,'').Replace([string][char]10,'').Replace(' ','');$c=[Text.Encoding]::Unicode.GetString([Convert]::FromBase64String($s));& ([ScriptBlock]::Create($c))"

endlocal
exit /b 0

